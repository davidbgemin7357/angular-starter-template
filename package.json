{
  "name": "layout-lib",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve",
    "start:red": "npm run build:lib && ng serve --host 0.0.0.0",
    "build:lib": "ng build db-ui-kit",
    "watch:lib": "ng build db-ui-kit --watch --configuration development",
    "build": "npm run build:lib && ng build layout-lib",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.23",
    "@tailwindcss/postcss": "^4.3.2",
    "flatpickr": "^4.6.13",
    "material-symbols": "^0.47.5",
    "postcss": "^8.5.16",
    "quill": "^2.0.2",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.2.17",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "jsdom": "^27.4.0",
    "karma": "^4.0.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "^4.0.2",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ng-packagr": "^21.2.5",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@babel/core": "7.29.7"
  }
